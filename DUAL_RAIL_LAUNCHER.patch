+  for i in $(ls $p/gids | sort -n); do [ "$(cat $p/gid_attrs/types/$i 2>/dev/null)" = "RoCE v2" ] &&
+    grep -q "ffff:$h\$" $p/gids/$i && { g=$i; break; }; done
+  [ -n "$g" ] || continue
+  o=$(ibv_devices 2>/dev/null | awk "NR>2{print \$1}" | grep -nx "$hca" | cut -d: -f1)
+  echo "${net:-?} $hca $g ${o:-0} $n"; done'
